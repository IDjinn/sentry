# .env.example — copy to .env and fill with real values.
# .env is gitignored; never commit secrets.
#
# docker compose automatically loads .env in the compose project directory
# (deploy/docker/) or the directory where you run `docker compose`.
# Place the .env there, or export these in your shell before running compose.

# Cloudflare edge action (ChallengeProvider).
# Create token: https://dash.cloudflare.com/profile/api-tokens
# Zone ID: dashboard → domain → Overview → API section → Zone ID
SENTRY_CF_TOKEN=
SENTRY_CF_ZONE=

# LLM provider API key (OpenRouter / OpenAI / Anthropic / Ollama).
SENTRY_LLM_KEY=

# Postgres connection (override for prod where password differs from dev).
# Used by docker-compose.prod.yml; dev compose uses SENTRY_PG_PASSWORD instead.
SENTRY_STORAGE__POSTGRES__URL=

# Postgres password (dev compose only).
SENTRY_PG_PASSWORD=changeme
