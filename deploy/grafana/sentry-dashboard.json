{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sentry_events_processed_total[$__rate_interval]))",
          "legendFormat": "events",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pipeline blocks / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sentry_actions_total{verdict=\"block\"}[$__rate_interval]))",
          "legendFormat": "blocks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Edge fast-path denials / sec",
      "description": "Sticky block-table denials before the pipeline (inline mode).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sentry_edge_block_hits_total[$__rate_interval]))",
          "legendFormat": "denials",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Block table size",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "max(sentry_block_table_size)",
          "legendFormat": "ips",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events by risk level",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sort_desc(sum by (kind) (rate(sentry_signals_total[$__rate_interval])))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top signal kinds",
      "description": "Pipeline signals by kind — same keys as [scorer.weights].",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "topk(8, sum by (kind) (rate(sentry_signal_kinds_total[$__rate_interval])))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Actions by name and verdict",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "topk(10, sum by (action, verdict) (rate(sentry_actions_total[$__rate_interval])))",
          "legendFormat": "{{action}}/{{verdict}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Verdict latency (p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sentry_pipeline_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sentry_pipeline_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent events (live log)",
      "description": "Per-event detail from GET /api/events on the [metrics] server. Requires the Infinity datasource.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "type": "json",
          "source": "url",
          "url": "http://localhost:9100/api/events?limit=100",
          "format": "table",
          "refId": "events",
          "url_options": { "method": "GET" },
          "null_value": ""
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "ts", "destinationType": "time" }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "asn": true,
              "country": true,
              "host": true,
              "signals": true,
              "source": true,
              "user_agent": true
            },
            "indexByName": {
              "ts": 0,
              "ip": 1,
              "method": 2,
              "path": 3,
              "status": 4,
              "protocol": 5,
              "risk_level": 6,
              "score": 7,
              "rule_hit": 8,
              "verdict": 9
            },
            "renameByName": {
              "ts": "Time",
              "ip": "IP",
              "method": "Method",
              "path": "Path",
              "status": "Status",
              "protocol": "Proto",
              "risk_level": "Level",
              "score": "Score",
              "rule_hit": "Rule / Signal",
              "verdict": "Verdict"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "special", "options": { "match": "null", "result": { "text": "", "index": 0 } } },
            { "type": "special", "options": { "match": "empty", "result": { "text": "", "index": 1 } } },
            { "type": "regex", "options": { "pattern": "^null$", "result": { "text": "" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 75 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [ { "id": "custom.width", "value": 165 } ] },
          { "matcher": { "id": "byName", "options": "IP" }, "properties": [ { "id": "custom.width", "value": 135 } ] },
          { "matcher": { "id": "byName", "options": "Method" }, "properties": [ { "id": "custom.width", "value": 70 } ] },
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [ { "id": "custom.width", "value": 65 } ] },
          { "matcher": { "id": "byName", "options": "Proto" }, "properties": [ { "id": "custom.width", "value": 60 } ] },
          {
            "matcher": { "id": "byName", "options": "Level" },
            "properties": [
              { "id": "custom.width", "value": 80 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "index": 0 }, "high": { "color": "orange", "index": 1 }, "medium": { "color": "yellow", "index": 2 }, "low": { "color": "blue", "index": 3 } } }
                ]
              }
            ]
          },
          { "matcher": { "id": "byName", "options": "Score" }, "properties": [ { "id": "custom.width", "value": 60 } ] },
          {
            "matcher": { "id": "byName", "options": "Verdict" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "block": { "color": "red", "index": 0 }, "challenge": { "color": "orange", "index": 1 }, "rate_limit": { "color": "yellow", "index": 2 }, "quarantine": { "color": "dark-red", "index": 3 }, "allow": { "color": "green", "index": 4 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [ { "displayName": "Time", "desc": true } ],
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sentry", "waf"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "DS_INFINITY",
        "label": "Infinity",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sentry — access monitor",
  "uid": "sentry-overview",
  "version": 1,
  "weekStart": ""
}
