# deploy/honeypot/.env — secrets for the honeypot stack.
# Copy to `.env` on the VPS and fill with strong random values
# (e.g. `openssl rand -base64 24`). Never commit the real .env.

# Postgres password (used by sentry + postgres services).
SENTRY_PG_PASSWORD=change-me-strong

# HMAC key for Sentry dashboard session cookies (32+ bytes).
SENTRY_SESSION_SECRET=change-me-32-bytes-minimum-random

# Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=change-me-strong

# (Not used by compose — keep a copy of the Sentry dashboard admin password
# generated during setup; the Argon2id hash goes into sentry.toml.)
# SENTRY_DASH_ADMIN_PASSWORD=

# Discord webhook for High/Critical incident alerts (referenced by the
# webhook action's url_env in sentry.toml).
SENTRY_DISCORD_WEBHOOK_URL=

# TypeSafe jev API key for [llm] provider = "jev" (sentry service only).
# Get one at https://console.typesafe.ai/settings/keys.
SENTRY_JEV_KEY=
